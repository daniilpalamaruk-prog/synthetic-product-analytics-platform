CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=synthetic_saas
DATASET_PATH=./data/demo/clean
# Copy to .env only for local development; never commit real values.
PII_HMAC_SECRET=replace-with-at-least-16-random-bytes
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=replace-with-a-fernet-key
WAREHOUSE_URL=sqlite:///data/warehouse.db
AIRFLOW_INGEST_CRON=0 * * * *
AIRFLOW_MARTS_CRON=0 6 * * *
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-local-airflow-password
POSTGRES_USER=analytics
POSTGRES_PASSWORD=replace-local-postgres-password
GREENPLUM_PASSWORD=replace-local-greenplum-password
SUPERSET_SECRET_KEY=replace-with-at-least-32-random-bytes
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=replace-local-superset-password
