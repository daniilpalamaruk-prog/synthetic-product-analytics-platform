{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "events",
  "type": "object",
  "required": ["event_id", "event_time", "event_name", "session_id"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": ["string", "null"], "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "event_time": {"type": "string", "format": "date-time"},
    "event_name": {"enum": ["ad_impression", "ad_click", "signup", "onboarding_started", "onboarding_step_completed", "onboarding_completed", "login", "feature_viewed", "feature_used", "trial_started", "checkout_started", "payment_attempted", "payment_success", "payment_failed", "subscription_started", "subscription_renewed", "subscription_cancelled", "refund_requested", "refund_completed", "notification_disabled"]},
    "feature_name": {"type": ["string", "null"]},
    "experiment_variant": {"type": ["string", "null"], "enum": ["control", "treatment", "new_pricing", null]}
  },
  "additionalProperties": true
}

