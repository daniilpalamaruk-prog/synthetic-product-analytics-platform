{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "experiments", "type": "object",
  "required": ["experiment_id", "experiment_name", "started_at", "ended_at", "primary_metric", "status"],
  "properties": {"experiment_id": {"type": "string"}, "status": {"enum": ["draft", "running", "completed", "stopped"]}},
